PROJECT_NAME="Plataforma de Acreditaciones"
DEBUG=false

# Entorno de ejecución: development | production (default: development).
# En "production" la app: (1) se NIEGA a arrancar si AUTH_DISABLED=true,
# (2) desactiva /docs y /redoc, (3) advierte en logs si CORS_ORIGINS tiene localhost.
ENVIRONMENT=development

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=acreditaciones

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# SMTP — leave SMTP_USER empty to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=Acreditaciones <tu_cuenta@gmail.com>

# Scheduler
SCHEDULER_TIMEZONE=America/Santiago
NOTIFICATION_HOUR=8
NOTIFICATION_MINUTE=0

# CORS — JSON list of allowed origins; override in production
# CORS_ORIGINS=["https://miapp.example.com","https://api.example.com"]

# OpenAI — leave OPENAI_API_KEY empty to disable AI document scanning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Microsoft Entra ID (M365) authentication
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Comma-separated list of emails that receive is_admin=True on first login
ADMIN_EMAILS=admin@empresa.com,otro@empresa.com
# ⚠️ NEVER set to true in production — bypasses all authentication
AUTH_DISABLED=false
#
# IMPORTANT — App Registration must expose the scope "access_as_user":
#   Azure Portal → App Registrations → Expose an API
#   → Application ID URI: api://<ENTRA_CLIENT_ID>
#   → Add scope: access_as_user (Admins and users)
#   → API permissions → grant Admin consent
# The frontend requests this scope so access_token carries aud=api://<CLIENT_ID>.
