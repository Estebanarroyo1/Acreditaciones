PROJECT_NAME="Plataforma de Acreditaciones"
DEBUG=false

# Entorno de ejecución: development | production (default: development).
# En "production" la app: (1) se NIEGA a arrancar si AUTH_DISABLED=true,
# (2) desactiva /docs y /redoc, (3) advierte en logs si CORS_ORIGINS tiene localhost.
ENVIRONMENT=development

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=acreditaciones

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# SMTP — leave SMTP_USER empty to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=Acreditaciones <tu_cuenta@gmail.com>

# Scheduler
SCHEDULER_TIMEZONE=America/Santiago
NOTIFICATION_HOUR=8
NOTIFICATION_MINUTE=0

# CORS — JSON list of allowed origins; override in production
# CORS_ORIGINS=["https://miapp.example.com","https://api.example.com"]

# OpenAI — leave OPENAI_API_KEY empty to disable AI document scanning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Autenticación local (email + contraseña, JWT propio HS256)
# JWT_SECRET_KEY: clave secreta para firmar los tokens. En producción la app se
# NIEGA a arrancar si queda vacía o con el valor de ejemplo. Genera una así:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-secret-change-me-not-for-production
# Vida del access token en minutos (480 = 8 h de jornada laboral)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# ⚠️ NEVER set to true in production — bypasses all authentication
AUTH_DISABLED=false
